# Optional proxy for backend YouTube requests. Leave empty for normal access.
# Other proxy variables from your shell may still apply; see README.md.
YT_PROXY=
# Example: YT_PROXY=http://127.0.0.1:7890

# Optional Douyin settings. Defaults use a dedicated local browser profile and
# the runtime/model installed by the platform's setup-douyin script.
# Never paste cookies here. Restart the app after changing runtime settings.
# auto uses detected installed Chrome on macOS/Windows, otherwise bundled Chromium.
# Allowed browser channels: auto, chrome, chromium, msedge.
# DOUYIN_BROWSER_CHANNEL=auto
# DOUYIN_BROWSER_PROFILE=/absolute/path/to/dedicated-profile
# auto keeps MLX on macOS; other platforms select faster-whisper.
# STT_BACKEND=auto
# faster-whisper only: auto chooses detected NVIDIA CUDA or CPU.
# STT_DEVICE=auto
# STT_COMPUTE_TYPE=auto
# Optional absolute overrides; prefer the venv executable, not its base interpreter.
# Example macOS overrides:
# STT_PYTHON=/absolute/path/to/stt/.venv/bin/python
# STT_MODEL_DIR=/absolute/path/to/local/whisper-turbo
# Windows defaults are relative to the project location, with no override needed:
#   stt/windows/.venv/Scripts/python.exe
#   stt/windows/models/whisper-turbo
# Example Windows overrides use forward slashes:
# STT_PYTHON=C:/path/to/project/stt/windows/.venv/Scripts/python.exe
# STT_MODEL_DIR=C:/path/to/project/stt/windows/models/whisper-turbo
# Windows setup preserves existing keys, including an explicit STT_DEVICE=cpu.
